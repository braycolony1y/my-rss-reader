const sleep = ms =>
    new Promise(resolve => setTimeout(resolve, ms));

export const GEMINI_WEB_URL =
    process.env.GEMINI_WEB_URL ||
    'https://gemini.google.com/u/1/app';

export const GEMINI_WEB_MODEL = '3.8 Flash';

// User requirement: exactly two Gemini Web AI slots.
export const GEMINI_WEB_CONCURRENCY = 2;

const GEMINI_WEB_PROFILE =
    process.env.GEMINI_WEB_PROFILE ||
    process.env.OPENCLI_BROWSER_PROFILE ||
    process.env.OPENCLI_PROFILE ||
    '3ggyam53';

const GEMINI_WEB_COOLDOWN_MS = Math.max(
    5000,
    Number(process.env.GEMINI_WEB_COOLDOWN_MS) || 30000
);

const slots = Array.from(
    { length: GEMINI_WEB_CONCURRENCY },
    (_, index) => ({
        id: index + 1,
        busy: false,
        page: null
    })
);

const waiters = [];

let retryAt = 0;
let browserModulesPromise = null;

export function geminiWebAvailable() {
    return process.env.GEMINI_WEB_ENABLED !== 'false';
}

async function browserModules() {
    if (!browserModulesPromise) {
        browserModulesPromise = Promise.all([
            import(
                '../../node_modules/@jackwener/opencli/dist/src/browser/page.js'
            ),
            import(
                '../../node_modules/@jackwener/opencli/dist/src/browser/daemon-client.js'
            )
        ]).then(([
            { Page },
            { setDaemonCommandTimeoutSeconds }
        ]) => {
            setDaemonCommandTimeoutSeconds(35);
            return { Page };
        });
    }

    return browserModulesPromise;
}

async function acquireSlot() {
    const free = slots.find(slot => !slot.busy);

    if (free) {
        free.busy = true;
        return free;
    }

    return new Promise(resolve => {
        waiters.push(resolve);
    });
}

function releaseSlot(slot) {
    const next = waiters.shift();

    if (next) {
        // Slot remains busy; ownership transfers directly.
        next(slot);
        return;
    }

    slot.busy = false;
}

async function getPage(slot) {
    if (slot.page) return slot.page;

    const { Page } = await browserModules();

    slot.page = new Page(
        `rss-gemini-web-${slot.id}`,
        180,
        undefined,
        'background',
        'browser',
        'persistent',
        GEMINI_WEB_PROFILE
    );

    return slot.page;
}

async function collectDiagnostics(page) {
    return page.evaluate(() => {
        const visible = element => {
            if (!element) return false;
            const style = getComputedStyle(element);
            const rect = element.getBoundingClientRect();

            return (
                style.display !== 'none' &&
                style.visibility !== 'hidden' &&
                rect.width > 0 &&
                rect.height > 0
            );
        };

        const label = element =>
            [
                element.innerText,
                element.getAttribute('aria-label'),
                element.getAttribute('title'),
                element.getAttribute('data-tooltip')
            ]
                .filter(Boolean)
                .join(' ')
                .replace(/\s+/g, ' ')
                .trim();

        return {
            url: location.href,
            title: document.title,
            buttons: [
                ...document.querySelectorAll(
                    'button,[role="button"],[role="menuitem"],[role="option"]'
                )
            ]
                .filter(visible)
                .map(label)
                .filter(Boolean)
                .slice(0, 50),

            inputs: [
                ...document.querySelectorAll(
                    'textarea,[contenteditable="true"]'
                )
            ]
                .filter(visible)
                .map(element => ({
                    tag: element.tagName,
                    role: element.getAttribute('role'),
                    aria: element.getAttribute('aria-label'),
                    placeholder:
                        element.getAttribute('placeholder'),
                    className:
                        String(element.className || '')
                            .slice(0, 120)
                }))
                .slice(0, 20)
        };
    });
}

async function providerError(
    page,
    message,
    code
) {
    const error = new Error(message);
    error.code = code;

    try {
        error.ui = await collectDiagnostics(page);
    } catch {
        // Diagnostics must never hide the original error.
    }

    throw error;
}

async function waitForGeminiPage(
    page,
    timeoutMs = 20000
) {
    const deadline = Date.now() + timeoutMs;

    while (Date.now() < deadline) {
        const state = await page.evaluate(() => ({
            url: location.href,
            readyState: document.readyState,
            title: document.title || '',
            bodyLength:
                (document.body?.innerText || '').length
        })).catch(() => null);

        if (state) {
            if (
                /accounts\.google\.com/i.test(state.url)
            ) {
                return providerError(
                    page,
                    'Gemini Web requires the Google account to be signed in',
                    'GEMINI_WEB_LOGIN_REQUIRED'
                );
            }

            if (
                state.readyState !== 'loading' &&
                state.bodyLength > 100
            ) {
                return state;
            }
        }

        await sleep(300);
    }

    return providerError(
        page,
        'Gemini Web did not become ready',
        'GEMINI_WEB_PAGE_TIMEOUT'
    );
}

async function temporaryChatState(page) {
    return page.evaluate(() => {
        const visible = element => {
            const style = getComputedStyle(element);
            const rect = element.getBoundingClientRect();

            return (
                style.display !== 'none' &&
                style.visibility !== 'hidden' &&
                rect.width > 0 &&
                rect.height > 0
            );
        };

        const label = element =>
            [
                element.innerText,
                element.getAttribute('aria-label'),
                element.getAttribute('title'),
                element.getAttribute('data-tooltip')
            ]
                .filter(Boolean)
                .join(' ')
                .replace(/\s+/g, ' ')
                .trim();

        const controls = [
            ...document.querySelectorAll(
                'button,[role="button"]'
            )
        ].filter(visible);

        const temporary = controls.map(element => ({
            element,
            label: label(element),
            pressed: element.getAttribute('aria-pressed')
        })).filter(item =>
            /temporary chat/i.test(item.label)
        );

        const turnOn = temporary.find(item =>
            /turn on temporary chat/i.test(item.label)
        );

        const enabled =
            temporary.some(item =>
                /turn off temporary chat|disable temporary chat/i
                    .test(item.label) ||
                item.pressed === 'true'
            );

        const bodyLines =
            (document.body?.innerText || '')
                .split('\n')
                .map(line => line.trim())
                .filter(Boolean);

        const marker =
            bodyLines.some(line =>
                /^temporary chat$/i.test(line)
            );

        return {
            enabled:
                enabled ||
                (
                    !turnOn &&
                    marker
                ),
            canEnable: Boolean(turnOn),
            labels:
                temporary.map(item => item.label)
        };
    });
}

async function ensureTemporaryChat(page) {
    let state = await temporaryChatState(page);

    if (state.enabled) return;

    if (!state.canEnable) {
        return providerError(
            page,
            'Could not find the Turn on temporary chat control',
            'GEMINI_WEB_TEMP_CHAT_NOT_FOUND'
        );
    }

    const clicked = await page.evaluate(() => {
        const visible = element => {
            const style = getComputedStyle(element);
            const rect = element.getBoundingClientRect();

            return (
                style.display !== 'none' &&
                style.visibility !== 'hidden' &&
                rect.width > 0 &&
                rect.height > 0
            );
        };

        const label = element =>
            [
                element.innerText,
                element.getAttribute('aria-label'),
                element.getAttribute('title'),
                element.getAttribute('data-tooltip')
            ]
                .filter(Boolean)
                .join(' ')
                .replace(/\s+/g, ' ')
                .trim();

        const control = [
            ...document.querySelectorAll(
                'button,[role="button"]'
            )
        ].filter(visible).find(element =>
            /turn on temporary chat/i.test(
                label(element)
            )
        );

        if (!control) return false;

        control.click();
        return true;
    });

    if (!clicked) {
        return providerError(
            page,
            'Temporary Chat could not be enabled',
            'GEMINI_WEB_TEMP_CHAT_CLICK_FAILED'
        );
    }

    const deadline = Date.now() + 7000;

    while (Date.now() < deadline) {
        await sleep(250);
        state = await temporaryChatState(page);

        if (state.enabled) return;
    }

    return providerError(
        page,
        'Temporary Chat could not be confirmed as enabled',
        'GEMINI_WEB_TEMP_CHAT_NOT_CONFIRMED'
    );
}

async function modelState(page) {
    return page.evaluate(() => {
        const visible = element => {
            const style = getComputedStyle(element);
            const rect = element.getBoundingClientRect();

            return (
                style.display !== 'none' &&
                style.visibility !== 'hidden' &&
                rect.width > 0 &&
                rect.height > 0
            );
        };

        const label = element =>
            [
                element.innerText,
                element.getAttribute('aria-label'),
                element.getAttribute('title')
            ]
                .filter(Boolean)
                .join(' ')
                .replace(/\s+/g, ' ')
                .trim();

        const controls = [
            ...document.querySelectorAll(
                'button,[role="button"],[role="menuitem"],[role="option"]'
            )
        ].filter(visible);

        const selected = controls.filter(element => {
            const role =
                element.getAttribute('role') || '';

            return (
                element.getAttribute('aria-selected') ===
                    'true' ||
                element.getAttribute('aria-checked') ===
                    'true' ||
                element.getAttribute('aria-pressed') ===
                    'true' ||
                (
                    !['menuitem', 'option'].includes(role) &&
                    /3\.8 flash|3\.5 flash-lite|3\.1 pro|extended thinking/i
                        .test(label(element))
                )
            );
        });

        const selectedLabels =
            selected.map(label);

        const selected38 =
            selectedLabels.some(value =>
                /3\.8 flash/i.test(value)
            );

        const selectedExtended =
            selectedLabels.some(value =>
                /extended thinking/i.test(value)
            );

        return {
            ok:
                selected38 &&
                !selectedExtended,
            selectedLabels
        };
    });
}

async function ensureModel(page) {
    let state = await modelState(page);

    if (state.ok) return;

    // Open the model/mode selector.
    await page.evaluate(() => {
        const visible = element => {
            const style = getComputedStyle(element);
            const rect = element.getBoundingClientRect();

            return (
                style.display !== 'none' &&
                style.visibility !== 'hidden' &&
                rect.width > 0 &&
                rect.height > 0
            );
        };

        const label = element =>
            [
                element.innerText,
                element.getAttribute('aria-label'),
                element.getAttribute('title')
            ]
                .filter(Boolean)
                .join(' ')
                .replace(/\s+/g, ' ')
                .trim();

        const controls = [
            ...document.querySelectorAll(
                'button,[role="button"]'
            )
        ].filter(visible);

        const trigger = controls.find(element =>
            /3\.5 flash-lite|3\.8 flash|3\.1 pro|extended thinking/i
                .test(label(element)) ||
            /choose model|select model|model selector/i
                .test(label(element))
        );

        if (!trigger) return false;

        trigger.click();
        return true;
    });

    await sleep(400);

    const selected = await page.evaluate(() => {
        const visible = element => {
            const style = getComputedStyle(element);
            const rect = element.getBoundingClientRect();

            return (
                style.display !== 'none' &&
                style.visibility !== 'hidden' &&
                rect.width > 0 &&
                rect.height > 0
            );
        };

        const label = element =>
            [
                element.innerText,
                element.getAttribute('aria-label'),
                element.getAttribute('title')
            ]
                .filter(Boolean)
                .join(' ')
                .replace(/\s+/g, ' ')
                .trim();

        const candidates = [
            ...document.querySelectorAll(
                'button,[role="button"],[role="menuitem"],[role="option"]'
            )
        ].filter(visible).filter(element =>
            /^3\.8 flash\b/i.test(
                label(element)
            )
        );

        candidates.sort((a, b) => {
            const rank = element =>
                ['menuitem', 'option'].includes(
                    element.getAttribute('role')
                )
                    ? 0
                    : 1;

            return rank(a) - rank(b);
        });

        if (!candidates[0]) return false;

        candidates[0].click();
        return true;
    });

    if (!selected) {
        return providerError(
            page,
            'Gemini Web could not find the 3.8 Flash model option',
            'GEMINI_WEB_MODEL_NOT_FOUND'
        );
    }

    const deadline = Date.now() + 7000;

    while (Date.now() < deadline) {
        await sleep(250);
        state = await modelState(page);

        if (state.ok) return;
    }

    return providerError(
        page,
        'Gemini Web could not confirm 3.8 Flash with Extended thinking off',
        'GEMINI_WEB_MODEL_NOT_CONFIRMED'
    );
}

async function setPrompt(page, text) {
    const result = await page.evaluate(promptText => {
        const visible = element => {
            const style = getComputedStyle(element);
            const rect = element.getBoundingClientRect();

            return (
                style.display !== 'none' &&
                style.visibility !== 'hidden' &&
                rect.width > 0 &&
                rect.height > 0
            );
        };

        const candidates = [
            ...document.querySelectorAll(
                'textarea,[contenteditable="true"]'
            )
        ].filter(element =>
            visible(element) &&
            !element.disabled
        );

        const score = element => {
            const description = [
                element.getAttribute('aria-label'),
                element.getAttribute('placeholder'),
                element.getAttribute('role'),
                element.className
            ]
                .filter(Boolean)
                .join(' ');

            let value = 0;

            if (/prompt|message|ask gemini/i.test(description)) {
                value += 20;
            }

            if (element.getAttribute('role') === 'textbox') {
                value += 10;
            }

            if (/ql-editor/i.test(String(element.className))) {
                value += 8;
            }

            if (element.isContentEditable) {
                value += 4;
            }

            return value;
        };

        candidates.sort(
            (a, b) =>
                score(b) - score(a)
        );

        const editor = candidates[0];

        if (!editor) {
            return {
                ok: false
            };
        }

        editor.focus();

        if (
            editor instanceof HTMLTextAreaElement ||
            editor instanceof HTMLInputElement
        ) {
            const prototype =
                editor instanceof HTMLTextAreaElement
                    ? HTMLTextAreaElement.prototype
                    : HTMLInputElement.prototype;

            const setter =
                Object.getOwnPropertyDescriptor(
                    prototype,
                    'value'
                )?.set;

            if (setter) {
                setter.call(
                    editor,
                    promptText
                );
            } else {
                editor.value =
                    promptText;
            }

            editor.dispatchEvent(
                new Event(
                    'input',
                    {
                        bubbles: true
                    }
                )
            );
        } else {
            try {
                document.execCommand(
                    'selectAll',
                    false,
                    null
                );

                document.execCommand(
                    'insertText',
                    false,
                    promptText
                );
            } catch {
                // Fall through to direct content update.
            }

            if (
                !String(editor.innerText || '')
                    .trim()
            ) {
                editor.textContent =
                    promptText;

                editor.dispatchEvent(
                    new InputEvent(
                        'input',
                        {
                            bubbles: true,
                            inputType:
                                'insertText',
                            data:
                                promptText
                        }
                    )
                );
            }
        }

        return {
            ok: true
        };
    }, text);

    if (!result?.ok) {
        return providerError(
            page,
            'Gemini Web prompt editor was not found',
            'GEMINI_WEB_PROMPT_NOT_FOUND'
        );
    }
}

async function submitPrompt(page) {
    const deadline = Date.now() + 6000;

    while (Date.now() < deadline) {
        const submitted = await page.evaluate(() => {
            const visible = element => {
                const style = getComputedStyle(element);
                const rect = element.getBoundingClientRect();

                return (
                    style.display !== 'none' &&
                    style.visibility !== 'hidden' &&
                    rect.width > 0 &&
                    rect.height > 0
                );
            };

            const label = element =>
                [
                    element.innerText,
                    element.getAttribute('aria-label'),
                    element.getAttribute('title'),
                    element.getAttribute('data-tooltip')
                ]
                    .filter(Boolean)
                    .join(' ')
                    .replace(/\s+/g, ' ')
                    .trim();

            const buttons = [
                ...document.querySelectorAll('button')
            ].filter(element =>
                visible(element) &&
                !element.disabled
            );

            const send = buttons.find(element =>
                /send message|^send$/i.test(
                    label(element)
                )
            );

            if (send) {
                send.click();
                return true;
            }

            return false;
        });

        if (submitted) return;

        await sleep(150);
    }

    return providerError(
        page,
        'Gemini Web send button was not available',
        'GEMINI_WEB_SEND_NOT_FOUND'
    );
}

async function responseState(page) {
    return page.evaluate(() => {
        const visible = element => {
            const style = getComputedStyle(element);
            const rect = element.getBoundingClientRect();

            return (
                style.display !== 'none' &&
                style.visibility !== 'hidden' &&
                rect.width > 0 &&
                rect.height > 0
            );
        };

        const modelResponses = [
            ...document.querySelectorAll(
                'model-response'
            )
        ].filter(visible);

        let text = '';

        if (modelResponses.length) {
            text =
                modelResponses[
                    modelResponses.length - 1
                ].innerText || '';
        }

        if (!text.trim()) {
            const alternatives = [
                ...document.querySelectorAll(
                    '[data-message-author-role="model"],.model-response-text,.response-container-content'
                )
            ].filter(visible);

            if (alternatives.length) {
                text =
                    alternatives[
                        alternatives.length - 1
                    ].innerText || '';
            }
        }

        const controls = [
            ...document.querySelectorAll(
                'button,[role="button"]'
            )
        ].filter(visible);

        const generating =
            controls.some(element => {
                const label = [
                    element.innerText,
                    element.getAttribute('aria-label'),
                    element.getAttribute('title')
                ]
                    .filter(Boolean)
                    .join(' ');

                return /stop response|stop generating|cancel response/i
                    .test(label);
            });

        const alerts = [
            ...document.querySelectorAll(
                '[role="alert"],[aria-live="assertive"],.error-message'
            )
        ]
            .filter(visible)
            .map(element =>
                String(element.innerText || '')
                    .replace(/\s+/g, ' ')
                    .trim()
            )
            .filter(Boolean)
            .join(' ');

        return {
            text: text.trim(),
            generating,
            alerts: alerts.slice(0, 1000)
        };
    });
}

async function waitForResponse(
    page,
    baseline,
    timeoutMs
) {
    const deadline =
        Date.now() + timeoutMs;

    let lastText = '';
    let stableCount = 0;
    let started = false;

    while (Date.now() < deadline) {
        const state =
            await responseState(page);

        if (
            state.text &&
            state.text !== baseline
        ) {
            started = true;

            if (state.text === lastText) {
                stableCount++;
            } else {
                stableCount = 0;
                lastText = state.text;
            }

            if (
                !state.generating &&
                stableCount >= 3
            ) {
                return state.text;
            }
        }

        if (
            !started &&
            /reached your limit|too many requests|try again later|couldn.t generate|something went wrong/i
                .test(state.alerts)
        ) {
            const error =
                new Error(
                    'Gemini Web reported a generation/rate-limit error'
                );

            error.code =
                'GEMINI_WEB_GENERATION_ERROR';

            throw error;
        }

        await sleep(500);
    }

    const error =
        new Error(
            'Gemini Web response timed out'
        );

    error.code =
        'GEMINI_WEB_TIMEOUT';

    throw error;
}

function cleanResponse(text) {
    return String(text || '')
        .trim()
        .replace(
            /^```(?:json)?\s*/i,
            ''
        )
        .replace(
            /\s*```$/,
            ''
        )
        .trim();
}

function buildInput(prompt, options) {
    let input =
        'Use only the information supplied in this prompt. ' +
        'Do not browse the web or use external tools.\n\n' +
        String(prompt || '');

    if (options?.schema) {
        input +=
            '\n\nReturn output that conforms exactly to this JSON Schema:\n' +
            JSON.stringify(options.schema);
    }

    if (options?.json) {
        input +=
            '\n\nReturn valid JSON only. Do not wrap it in Markdown fences.';
    }

    return input;
}

async function runOnSlot(
    slot,
    prompt,
    options
) {
    const page =
        await getPage(slot);

    try {
        await page.goto(
            GEMINI_WEB_URL,
            {
                settleMs: 1800
            }
        );

        await waitForGeminiPage(page);

        // Strict requirements:
        // 1. Temporary Chat must be ON.
        // 2. Model must be 3.8 Flash.
        // 3. Extended thinking must NOT be selected.
        await ensureTemporaryChat(page);
        await ensureModel(page);

        const before =
            await responseState(page);

        const input =
            buildInput(
                prompt,
                options
            );

        await setPrompt(
            page,
            input
        );

        options.onRequest?.();

        await submitPrompt(page);

        return await waitForResponse(
            page,
            before.text || '',
            Math.max(
                5000,
                Math.min(
                    180000,
                    Number(options.timeoutMs) ||
                    120000
                )
            )
        );
    } catch (error) {
        // Discard a bad tab/session. The slot itself remains reusable.
        try {
            await slot.page
                ?.closeWindow?.();
        } catch {
            // Ignore cleanup errors.
        }

        slot.page = null;

        throw error;
    }
}

export async function generateWithGeminiWeb(
    prompt,
    options = {}
) {
    if (!geminiWebAvailable()) {
        throw new Error(
            'Gemini Web provider is disabled'
        );
    }

    if (Date.now() < retryAt) {
        throw new Error(
            'Gemini Web is cooling down; use the next provider'
        );
    }

    const inputBytes =
        Buffer.byteLength(
            String(prompt || ''),
            'utf8'
        );

    if (inputBytes > 180000) {
        throw new Error(
            'Gemini Web prompt is too large'
        );
    }

    const slot =
        await acquireSlot();

    const startedAt =
        Date.now();

    try {
        const rawText =
            await runOnSlot(
                slot,
                prompt,
                options
            );

        const text =
            cleanResponse(rawText);

        if (!text) {
            const error =
                new Error(
                    'Gemini Web returned an empty response'
                );

            error.code =
                'GEMINI_WEB_EMPTY';

            throw error;
        }

        if (options.json) {
            try {
                JSON.parse(text);
            } catch {
                const error =
                    new Error(
                        'Gemini Web returned invalid JSON'
                    );

                error.code =
                    'GEMINI_WEB_INVALID_JSON';

                throw error;
            }
        }

        retryAt = 0;

        const usage = {
            promptTokens: 0,
            outputTokens: 0,
            totalTokens: 0
        };

        console.log(
            '[ONLINE AI]',
            JSON.stringify({
                at:
                    new Date()
                        .toISOString(),
                provider:
                    'gemini-web',
                operation:
                    options.operation ||
                    'summary',
                model:
                    GEMINI_WEB_MODEL,
                slot:
                    slot.id,
                status:
                    'success',
                durationMs:
                    Date.now() -
                    startedAt,
                ...usage
            })
        );

        return {
            text,
            provider:
                'gemini-web',
            modelUsed:
                GEMINI_WEB_MODEL,
            totalDuration:
                (
                    Date.now() -
                    startedAt
                ) * 1e6,
            usage,
            onlineAiUsage:
                usage,
            slot:
                slot.id
        };
    } catch (error) {
        retryAt =
            Date.now() +
            GEMINI_WEB_COOLDOWN_MS;

        console.log(
            '[ONLINE AI]',
            JSON.stringify({
                at:
                    new Date()
                        .toISOString(),
                provider:
                    'gemini-web',
                operation:
                    options.operation ||
                    'summary',
                model:
                    GEMINI_WEB_MODEL,
                slot:
                    slot.id,
                status:
                    'failed',
                durationMs:
                    Date.now() -
                    startedAt,
                errorCode:
                    String(
                        error.code ||
                        error.name ||
                        'GEMINI_WEB_FAILED'
                    ).slice(0, 80),
                error:
                    String(
                        error.message ||
                        error
                    )
                        .replace(
                            /\s+/g,
                            ' '
                        )
                        .slice(
                            0,
                            500
                        ),
                ui:
                    error.ui ||
                    undefined
            })
        );

        throw error;
    } finally {
        releaseSlot(slot);
    }
}
