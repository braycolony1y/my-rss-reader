async function waitForTemporaryChatState(
    page,
    expectedEnabled,
    timeoutMs = 8000
) {
    const deadline =
        Date.now() + timeoutMs;

    let state = null;

    while (Date.now() < deadline) {
        state =
            await temporaryChatState(
                page
            );

        if (
            state?.found &&
            state?.knownState &&
            state.enabled === expectedEnabled
        ) {
            return state;
        }

        await sleep(200);
    }

    return providerError(
        page,
        expectedEnabled
            ? 'Temporary Chat could not be confirmed ON'
            : 'Temporary Chat could not be confirmed OFF',
        expectedEnabled
            ? 'GEMINI_WEB_TEMP_CHAT_NOT_CONFIRMED'
            : 'GEMINI_WEB_TEMP_CHAT_RESET_FAILED'
    );
}


async function clickGeminiNewChatControl(
    page,
    timeoutMs = 5000
) {
    const deadline =
        Date.now() + timeoutMs;

    while (Date.now() < deadline) {
        const clicked =
            await page.evaluate(() => {
                const visible = element => {
                    if (!element) return false;

                    const style =
                        getComputedStyle(
                            element
                        );

                    const rect =
                        element
                            .getBoundingClientRect();

                    return (
                        style.display !==
                            'none' &&
                        style.visibility !==
                            'hidden' &&
                        rect.width > 0 &&
                        rect.height > 0
                    );
                };

                const control = [
                    ...document
                        .querySelectorAll(
                            'a[aria-label],button[aria-label],[role="button"][aria-label]'
                        )
                ]
                    .filter(visible)
                    .find(element =>
                        /^new chat$/i.test(
                            String(
                                element
                                    .getAttribute(
                                        'aria-label'
                                    ) ||
                                ''
                            )
                                .replace(
                                    /\s+/g,
                                    ' '
