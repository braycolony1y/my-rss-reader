                                .trim()
                        )
                    );

                if (!control) {
                    return false;
                }

                control.click();

                return true;
            }).catch(
                () => false
            );

        if (clicked) {
            return true;
        }

        await sleep(200);
    }

    return false;
}


async function waitForFreshNormalChat(
    page,
    timeoutMs = 12000
) {
    const deadline =
        Date.now() + timeoutMs;

    let state = null;

    while (Date.now() < deadline) {
        state =
            await temporaryChatState(
                page
            );

        /*
         * Fresh normal Gemini chat:
         *
         * - canonical /app route
         * - NOT currently Temporary Chat
         * - Temporary Chat button is available with
         *   gemini_chat_temp icon.
         */
        if (
            state?.freshRoute &&
            !state?.enabled &&
            state?.canEnable
        ) {
            return state;
        }

        await sleep(200);
    }

    return null;
}


async function returnToGeminiChatHome(page) {
    /*
     * Do NOT use page.goto('/app') as proof of a new chat.
     *
     * We directly observed an active Temporary Chat whose URL
     * was still /u/1/app.
     *
     * Prefer Gemini's actual visible "New chat" control.
     */
    const clicked =
        await clickGeminiNewChatControl(
            page,
            5000
        );

    if (clicked) {
        console.log(
            '[GEMINI WEB] New chat via real New chat control'
        );

        const fresh =
            await waitForFreshNormalChat(
                page,
                10000
            );

        if (fresh) {
            return fresh;
        }

        console.warn(
            '[GEMINI WEB] New chat control clicked but fresh normal chat was not confirmed; trying shortcut'
        );
    }
    else {
        console.warn(
            '[GEMINI WEB] New chat control not found; trying shortcut'
        );
    }

    /*
     * Compatibility fallback.
     */
    for (
        let attempt = 1;
        attempt <= 2;
        attempt += 1
    ) {
        try {
            await page.pressKey(
                'Escape'
            );
        }
        catch {
            // Nothing to close.
        }

        await sleep(150);

        console.log(
            `[GEMINI WEB] New chat via Ctrl+Shift+O (attempt ${attempt})`
        );

        await page.pressKey(
            'Control+Shift+O'
        );

        const fresh =
            await waitForFreshNormalChat(
                page,
                10000
            );

        if (fresh) {
            return fresh;
        }
    }

    return providerError(
        page,
        'Gemini could not reach a confirmed fresh normal chat',
        'GEMINI_WEB_NEW_CHAT_FAILED'
    );
}


async function resetFreshTemporaryChat(page) {
    let state =
        await waitForFreshNormalChat(
            page,
            3000
        );

    /*
     * If we somehow reached this function while still inside
     * an old Temporary Chat or another conversation, start a
     * real new conversation first.
     */
    if (!state) {
        console.warn(
            '[GEMINI WEB] Fresh normal chat not confirmed before Temporary Chat; resetting conversation'
        );

        await returnToGeminiChatHome(
            page
        );

        state =
            await waitForFreshNormalChat(
                page,
                10000
            );
    }

    if (!state) {
        return providerError(
            page,
            'Fresh normal Gemini chat could not be confirmed before enabling Temporary Chat',
            'GEMINI_WEB_FRESH_CHAT_NOT_CONFIRMED'
        );
    }

    const clickedOn =
        await clickTemporaryChatToggle(
            page
        );

    if (!clickedOn) {
        return providerError(
            page,
            'Could not start a fresh Temporary Chat',
            'GEMINI_WEB_TEMP_CHAT_CLICK_FAILED'
        );
    }

    /*
     * ON can now be confirmed by either:
     *
     * - toolbar icon = close
     * - chat-window.is-temporary-chat
     * - .chat-history.temporary-chat
     */
    await waitForTemporaryChatState(
        page,
        true,
        10000
    );
}


async function waitForModePicker(
    page,
    timeoutMs = 10000
) {
    const deadline = Date.now() + timeoutMs;

    while (Date.now() < deadline) {
        const found = await page.evaluate(() => {
            const element = document.querySelector(
                '[data-test-id="bard-mode-menu-button"]'
            );

            if (!element) return false;

            const style = getComputedStyle(element);
            const rect = element.getBoundingClientRect();

            return (
                style.display !== 'none' &&
                style.visibility !== 'hidden' &&
                rect.width > 0 &&
                rect.height > 0
            );
        }).catch(() => false);

        if (found) return;

        await sleep(250);
    }

    return providerError(
        page,
        'Gemini Web mode picker did not appear',
        'GEMINI_WEB_MODE_PICKER_NOT_FOUND'
    );
}


async function inspectModelMenu(page) {
    return page.evaluate(() => {
        const visible = element => {
            if (!element) return false;

            const style = getComputedStyle(element);
            const rect = element.getBoundingClientRect();

            return (
                style.display !== 'none' &&
                style.visibility !== 'hidden' &&
                rect.width > 0 &&
                rect.height > 0
            );
        };

        const menu = document.querySelector(
            '[data-test-id="gem-mode-menu"]'
        );

        if (!menu || !visible(menu)) {
            return {
                open: false,
                selectedText: '',
                selectedTestId: '',
                extendedSelected: false,
                flash38Present: false
            };
        }

        const items = [
            ...menu.querySelectorAll(
                '[role="menuitem"]'
            )
        ].filter(visible);

        const normalize = element =>
            String(element.innerText || '')
                .replace(/\s+/g, ' ')
                .trim();

        const isSelected = element =>
            element.classList.contains('selected') ||
            Boolean(
                element.querySelector(
                    'gem-icon[aria-label="Selected"]'
                )
            );

        const selected =
            items.find(isSelected) || null;

        const flash38 =
            items.find(element =>
                element.getAttribute('data-test-id') ===
                    'bard-mode-option-56fdd199312815e2' ||
                /^3\.8 Flash\b/i.test(
                    normalize(element)
                )
            ) || null;

        const extended =
            items.find(element =>
                /^Extended thinking\b/i.test(
                    normalize(element)
                )
            ) || null;

        return {
            open: true,
            selectedText:
                selected
                    ? normalize(selected)
                    : '',
            selectedTestId:
                selected?.getAttribute(
                    'data-test-id'
                ) || '',
            extendedSelected:
                Boolean(
                    extended &&
                    isSelected(extended)
                ),
            flash38Present:
                Boolean(flash38),
            flash38Selected:
                Boolean(
                    flash38 &&
                    isSelected(flash38)
                )
        };
    });
}


async function openModelMenu(page) {
    await waitForModePicker(page);

    const opened = await page.evaluate(() => {
        const button = document.querySelector(
            '[data-test-id="bard-mode-menu-button"]'
        );

        if (!button) return false;

        if (
            button.getAttribute('aria-expanded') ===
            'true'
        ) {
            return true;
        }

        button.click();
        return true;
    });

    if (!opened) {
        return providerError(
            page,
            'Gemini Web mode picker could not be opened',
            'GEMINI_WEB_MODE_PICKER_OPEN_FAILED'
        );
    }

    const deadline = Date.now() + 5000;

    while (Date.now() < deadline) {
        const state =
            await inspectModelMenu(page);

        if (state.open) {
            return state;
        }

        await sleep(150);
    }

    return providerError(
        page,
        'Gemini Web model menu did not open',
        'GEMINI_WEB_MODEL_MENU_TIMEOUT'
    );
}


async function closeModelMenu(page) {
    await page.evaluate(() => {
        const button = document.querySelector(
            '[data-test-id="bard-mode-menu-button"]'
        );

        if (
            button &&
            button.getAttribute('aria-expanded') ===
                'true'
        ) {
            button.click();
        }
    }).catch(() => {});

    await sleep(150);
}


async function modelState(page) {
    const state =
        await openModelMenu(page);

    /*
     * Strict validation:
     *
     * Gemini labels the collapsed picker simply "Flash",
     * which is ambiguous between Flash-Lite and 3.8 Flash.
     * Therefore we always inspect the open menu's selected
     * option rather than trusting the collapsed button text.
     */
    const ok =
        state.flash38Selected === true &&
        state.extendedSelected !== true &&
        (
            state.selectedTestId ===
                'bard-mode-option-56fdd199312815e2' ||
            /^3\.8 Flash\b/i.test(
                state.selectedText
            )
        );

    return {
        ...state,
        ok
    };
}


const GEMINI_WEB_MODES = Object.freeze({
    '3.8': {
        modelTestId:
            'bard-mode-option-56fdd199312815e2',
        modelName:
            '3.8 Flash',
        extended:
            false
    },

    '3.8-think': {
        modelTestId:
            'bard-mode-option-56fdd199312815e2',
        modelName:
            '3.8 Flash',
        extended:
            true
    },

    '3.1-pro': {
        modelTestId:
            'bard-mode-option-e6fa609c3fa255c0',
        modelName:
            '3.1 Pro',
        extended:
            false
    },

    '3.1-pro-think': {
        modelTestId:
            'bard-mode-option-e6fa609c3fa255c0',
        modelName:
            '3.1 Pro',
        extended:
            true
    }
});


function normalizeGeminiWebMode(value) {
    const mode =
        String(value || '3.8')
            .trim()
            .toLowerCase();

    if (GEMINI_WEB_MODES[mode]) {
        return mode;
    }

    return '3.8';
}


async function inspectRequestedMode(
    page,
    requestedMode
) {
    const config =
        GEMINI_WEB_MODES[
            normalizeGeminiWebMode(
                requestedMode
            )
        ];

    return page.evaluate(
        ({ modelTestId }) => {
            const menu =
                document.querySelector(
                    '[data-test-id="gem-mode-menu"]'
                );

            if (!menu) {
                return {
                    menuPresent: false
                };
            }

            const items = [
                ...menu.querySelectorAll(
                    '[role="menuitem"]'
                )
            ];

            const isSelected =
                element =>
                    Boolean(
                        element &&
                        (
                            element
                                .classList
                                .contains(
                                    'selected'
                                ) ||
                            element
                                .querySelector(
                                    '[aria-label="Selected"]'
                                )
                        )
                    );

            const textOf =
                element =>
                    String(
                        element?.innerText ||
                        ''
                    )
                        .replace(
                            /\s+/g,
                            ' '
                        )
                        .trim();

            const target =
                items.find(
                    element =>
                        element.getAttribute(
                            'data-test-id'
                        ) === modelTestId
                ) || null;

            const extended =
                items.find(
                    element =>
                        /^Extended thinking\b/i.test(
                            textOf(element)
                        )
                ) || null;

            const selectedBase =
                items.find(element => {
                    if (
                        !isSelected(element)
                    ) {
                        return false;
                    }

                    return Boolean(
                        element.getAttribute(
                            'data-test-id'
                        )
                    );
                }) || null;

            return {
                menuPresent:
                    true,

                targetPresent:
                    Boolean(target),

                targetSelected:
                    isSelected(target),

                targetText:
                    textOf(target),

                targetTestId:
                    target?.getAttribute(
                        'data-test-id'
                    ) || null,

                extendedPresent:
                    Boolean(extended),

                extendedSelected:
                    isSelected(extended),

                extendedText:
                    textOf(extended),

                selectedBaseText:
                    textOf(selectedBase),

                selectedBaseTestId:
                    selectedBase
                        ?.getAttribute(
                            'data-test-id'
                        ) ||
                    null
            };
        },
        {
            modelTestId:
                config.modelTestId
        }
    );
}


async function ensureModel(
    page,
    requestedMode = '3.8'
) {
    const mode =
        normalizeGeminiWebMode(
            requestedMode
        );

    const config =
        GEMINI_WEB_MODES[mode];

    await waitForModePicker(
        page,
        20000
    );

    await openModelMenu(page);

    let state =
        await inspectRequestedMode(
            page,
            mode
        );

    if (
        !state.menuPresent
    ) {
        return providerError(
            page,
            'Gemini Web model menu is not available',
            'GEMINI_WEB_MODEL_MENU_NOT_FOUND'
        );
    }

    if (
        !state.targetPresent
    ) {
        await closeModelMenu(page);

        return providerError(
            page,
            `Gemini Web ${config.modelName} option is not available`,
            'GEMINI_WEB_MODEL_NOT_FOUND'
        );
    }

    if (
        !state.extendedPresent
    ) {
        await closeModelMenu(page);

        return providerError(
            page,
            'Gemini Web Extended thinking control is not available',
            'GEMINI_WEB_THINKING_CONTROL_NOT_FOUND'
        );
    }

    /*
     * Step 1:
     * Select the requested base model.
     *
     * Base model and Extended thinking are independent
     * controls in the current Gemini UI.
     */
    if (
        !state.targetSelected
    ) {
        const selected =
            await page.evaluate(
                ({ modelTestId }) => {
                    const menu =
                        document.querySelector(
                            '[data-test-id="gem-mode-menu"]'
                        );

                    if (!menu) {
                        return false;
                    }

                    const target =
                        menu.querySelector(
                            `[data-test-id="${modelTestId}"]`
                        );

                    if (!target) {
                        return false;
                    }

                    target.click();

                    return true;
                },
                {
                    modelTestId:
                        config.modelTestId
                }
            );

        if (!selected) {
            return providerError(
                page,
                `Gemini Web could not select ${config.modelName}`,
                'GEMINI_WEB_MODEL_SELECT_FAILED'
            );
        }

        await sleep(600);

        /*
         * A model click normally closes the menu.
         * Re-open it before checking the independent
         * Extended-thinking control.
         */
        await openModelMenu(page);

        state =
            await inspectRequestedMode(
                page,
                mode
            );
    }

    /*
     * Step 2:
     * Explicitly set Extended thinking ON or OFF.
     *
     * Do not assume changing the base model changes
     * this state. Console testing confirmed Gemini
     * preserves it independently.
     */
    if (
        state.extendedSelected !==
        config.extended
    ) {
        const toggled =
            await page.evaluate(() => {
                const menu =
                    document.querySelector(
                        '[data-test-id="gem-mode-menu"]'
                    );

                if (!menu) {
                    return false;
                }

                const items = [
                    ...menu.querySelectorAll(
                        '[role="menuitem"]'
                    )
                ];

                const extended =
                    items.find(
                        element =>
                            /^Extended thinking\b/i.test(
                                String(
                                    element.innerText ||
                                    ''
                                )
                                    .replace(
                                        /\s+/g,
                                        ' '
                                    )
                                    .trim()
                            )
                    );

                if (!extended) {
                    return false;
                }

                extended.click();

                return true;
            });

        if (!toggled) {
            return providerError(
                page,
                `Gemini Web could not ${
                    config.extended
                        ? 'enable'
                        : 'disable'
                } Extended thinking`,
                'GEMINI_WEB_THINKING_TOGGLE_FAILED'
            );
        }

        await sleep(600);

        await openModelMenu(page);

        state =
            await inspectRequestedMode(
                page,
                mode
            );
    }

    /*
     * Step 3:
     * Positively verify BOTH controls.
     */
    const ok =
        state.targetSelected ===
            true &&
        state.extendedSelected ===
            config.extended;

    if (!ok) {
        await closeModelMenu(page);

        return providerError(
            page,
            `Gemini Web mode verification failed for ${mode}; base=${
                state.selectedBaseText ||
                state.selectedBaseTestId ||
                'unknown'
            }; extended=${
                state.extendedSelected
                    ? 'on'
                    : 'off'
            }`,
            'GEMINI_WEB_MODEL_NOT_CONFIRMED'
        );
    }

    console.log(
        `[GEMINI WEB] Mode ready: ${config.modelName}${
            config.extended
                ? ' + Extended thinking'
                : ''
        }`
    );

    await closeModelMenu(page);

    return {
        mode,
        model:
            config.modelName,
        extended:
            config.extended
    };
}


async function setPrompt(page, text) {
    const result = await page.evaluate(promptText => {
        const visible = element => {
            const style = getComputedStyle(element);
            const rect = element.getBoundingClientRect();

            return (
                style.display !== 'none' &&
                style.visibility !== 'hidden' &&
                rect.width > 0 &&
                rect.height > 0
            );
        };

        const candidates = [
            ...document.querySelectorAll(
                'textarea,[contenteditable="true"]'
            )
        ].filter(element =>
            visible(element) &&
            !element.disabled
        );

        const score = element => {
            const description = [
                element.getAttribute('aria-label'),
                element.getAttribute('placeholder'),
                element.getAttribute('role'),
                element.className
            ]
                .filter(Boolean)
                .join(' ');

            let value = 0;

            if (/prompt|message|ask gemini/i.test(description)) {
                value += 20;
            }

            if (element.getAttribute('role') === 'textbox') {
                value += 10;
            }

            if (/ql-editor/i.test(String(element.className))) {
                value += 8;
            }

            if (element.isContentEditable) {
                value += 4;
            }

            return value;
        };

        candidates.sort(
            (a, b) =>
                score(b) - score(a)
        );

        const editor = candidates[0];

        if (!editor) {
            return {
                ok: false
            };
        }

        editor.focus();

        if (
            editor instanceof HTMLTextAreaElement ||
            editor instanceof HTMLInputElement
        ) {
            const prototype =
                editor instanceof HTMLTextAreaElement
                    ? HTMLTextAreaElement.prototype
                    : HTMLInputElement.prototype;

            const setter =
                Object.getOwnPropertyDescriptor(
                    prototype,
                    'value'
                )?.set;

            if (setter) {
                setter.call(
                    editor,
                    promptText
                );
            } else {
                editor.value =
                    promptText;
            }

            editor.dispatchEvent(
                new Event(
                    'input',
                    {
                        bubbles: true
                    }
                )
            );
        } else {
            try {
                document.execCommand(
                    'selectAll',
                    false,
                    null
                );

                document.execCommand(
                    'insertText',
                    false,
                    promptText
                );
            } catch {
                // Fall through to direct content update.
            }

            if (
                !String(editor.innerText || '')
                    .trim()
            ) {
                editor.textContent =
                    promptText;

                editor.dispatchEvent(
                    new InputEvent(
                        'input',
                        {
                            bubbles: true,
                            inputType:
                                'insertText',
                            data:
                                promptText
                        }
                    )
                );
            }
        }

        return {
            ok: true
        };
    }, text);

    if (!result?.ok) {
        return providerError(
            page,
            'Gemini Web prompt editor was not found',
            'GEMINI_WEB_PROMPT_NOT_FOUND'
        );
    }
}

async function submitPrompt(page) {
    const deadline = Date.now() + 6000;

    while (Date.now() < deadline) {
        const submitted = await page.evaluate(() => {
            const visible = element => {
                const style = getComputedStyle(element);
                const rect = element.getBoundingClientRect();

                return (
                    style.display !== 'none' &&
                    style.visibility !== 'hidden' &&
                    rect.width > 0 &&
                    rect.height > 0
                );
            };

            const label = element =>
                [
                    element.innerText,
                    element.getAttribute('aria-label'),
                    element.getAttribute('title'),
                    element.getAttribute('data-tooltip')
                ]
                    .filter(Boolean)
                    .join(' ')
                    .replace(/\s+/g, ' ')
                    .trim();

            const buttons = [
                ...document.querySelectorAll('button')
            ].filter(element =>
                visible(element) &&
                !element.disabled
            );

            const send = buttons.find(element =>
                /send message|^send$/i.test(
                    label(element)
                )
            );

            if (send) {
                send.click();
                return true;
            }

            return false;
        });

        if (submitted) return;

        await sleep(150);
    }

    return providerError(
        page,
        'Gemini Web send button was not available',
        'GEMINI_WEB_SEND_NOT_FOUND'
    );
}

async function responseState(page) {
    return page.evaluate(() => {
        const visible = element => {
            const style = getComputedStyle(element);
            const rect = element.getBoundingClientRect();

            return (
                style.display !== 'none' &&
                style.visibility !== 'hidden' &&
                rect.width > 0 &&
                rect.height > 0
            );
        };

        const modelResponses = [
            ...document.querySelectorAll(
                'model-response'
            )
        ].filter(visible);

        let text = '';

        if (modelResponses.length) {
            text =
                modelResponses[
                    modelResponses.length - 1
                ].innerText || '';
        }

        if (!text.trim()) {
            const alternatives = [
                ...document.querySelectorAll(
                    '[data-message-author-role="model"],.model-response-text,.response-container-content'
                )
            ].filter(visible);

            if (alternatives.length) {
                text =
                    alternatives[
                        alternatives.length - 1
                    ].innerText || '';
            }
        }

        const controls = [
            ...document.querySelectorAll(
                'button,[role="button"]'
            )
        ].filter(visible);

        const generating =
            controls.some(element => {
                const label = [
                    element.innerText,
                    element.getAttribute('aria-label'),
                    element.getAttribute('title')
                ]
                    .filter(Boolean)
                    .join(' ');

                return /stop response|stop generating|cancel response/i
                    .test(label);
            });

        const alerts = [
            ...document.querySelectorAll(
                '[role="alert"],[aria-live="assertive"],.error-message'
            )
        ]
            .filter(visible)
            .map(element =>
                String(element.innerText || '')
                    .replace(/\s+/g, ' ')
                    .trim()
            )
            .filter(Boolean)
            .join(' ');

        return {
            text: text.trim(),
            generating,
            alerts: alerts.slice(0, 1000)
        };
    });
}

/*
 * GEMINI_WEB_JSON_COMPLETION_RECOVERY
 *
 * Gemini can remove its generating/Stop control before the
 * response DOM has finished settling.
 *
 * For JSON jobs, do not accept text that is obviously cut off.
 */
function geminiWebJsonCompletionState(value) {
    const text =
        cleanResponse(value);

    if (!text) {
        return {
            accepted: false,
            incomplete: true
        };
    }

    try {
        JSON.parse(text);

        return {
            accepted: true,
            incomplete: false
        };
    }
    catch {
        // Existing narrow quote repair gets one chance below.
    }

    /*
     * If the existing quote-only repair can produce valid JSON,
     * the document is complete enough. The normal parse layer
     * will perform and log that repair later.
     */
    const repair =
        repairGeminiWebJsonQuotes(
            text
        );

    if (repair.changed) {
        try {
            JSON.parse(
                repair.text
            );

            return {
                accepted: true,
                incomplete: false
            };
        }
        catch {
            // Continue with conservative structural checks.
        }
    }

    const trimmed =
        text.trim();

    const finalCharacter =
        trimmed[
            trimmed.length - 1
        ] || '';

    /*
     * This catches the failures we observed, for example:
     *
     * {"analysisReview":[{"label":"What changed",
     *
     * A complete top-level JSON object/array cannot end there.
     */
    if (
        finalCharacter !== '}' &&
        finalCharacter !== ']'
    ) {
        return {
            accepted: false,
            incomplete: true
        };
    }

    /*
     * Detect an outer object/array that is still open even when
     * the response happens to end after a complete inner object.
     *
     * If quote state itself is malformed, do NOT invent a repair;
     * hand it back to the existing parser/quote-repair path.
     */
    const stack = [];

    let inString = false;
    let escaped = false;
    let mismatch = false;

    for (const char of trimmed) {
        if (inString) {
            if (escaped) {
                escaped = false;
                continue;
            }

            if (char === '\\') {
                escaped = true;
                continue;
            }

            if (char === '"') {
                inString = false;
            }

            continue;
        }

        if (char === '"') {
            inString = true;
            continue;
        }

        if (
            char === '{' ||
            char === '['
        ) {
            stack.push(
                char
            );

            continue;
        }

        if (
            char === '}' ||
            char === ']'
        ) {
            const expected =
                char === '}'
                    ? '{'
                    : '[';

            if (
                stack[
                    stack.length - 1
                ] !== expected
            ) {
                mismatch = true;
                break;
            }

            stack.pop();
        }
    }

    if (
        !mismatch &&
        !inString &&
        stack.length > 0
    ) {
        return {
            accepted: false,
            incomplete: true
        };
    }

    /*
     * Complete-looking but malformed JSON is NOT treated as
     * truncation. Let the existing strict parser handle it.
     */
    return {
        accepted: false,
        incomplete: false
    };
}


async function waitForResponse(
    page,
    baseline,
    timeoutMs,
    expectJson = false
) {
    const deadline =
        Date.now() + timeoutMs;

    let lastText = '';
    let stableCount = 0;
    let started = false;

    let incompleteSince = 0;
    let incompleteLogged = false;

    const JSON_COMPLETION_GRACE_MS =
        12000;

    while (Date.now() < deadline) {
        const state =
            await responseState(page);

        /*
         * Gemini can show:
         *   "Something went wrong (1095)"
         *
         * as a snackbar/modal after the prompt was submitted.
         * Detect it on every response poll, even if generation already
         * produced partial text.
         */
        const error1095Visible =
            await page.evaluate(() => {
                const pattern =
                    /Something went wrong\s*\(\s*1095\s*\)/i;

                const selectors = [
                    '.mat-mdc-snack-bar-label',
                    'mat-snack-bar-container',
                    '.mat-mdc-snack-bar-container',
                    '[role="alert"]',
                    '[role="dialog"]',
                    '[aria-live]'
                ].join(',');

                const visible = element => {
                    if (!element) {
                        return false;
                    }

                    const style =
                        getComputedStyle(element);

                    const rect =
                        element.getBoundingClientRect();

                    return (
                        style.display !== 'none' &&
                        style.visibility !== 'hidden' &&
                        rect.width > 0 &&
                        rect.height > 0
                    );
                };

                for (
                    const element
                    of document.querySelectorAll(
                        selectors
                    )
                ) {
                    if (!visible(element)) {
                        continue;
                    }

                    const text =
                        String(
                            element.innerText ||
                            element.textContent ||
                            ''
                        )
                            .replace(/\s+/g, ' ')
                            .trim();

                    if (pattern.test(text)) {
                        return true;
                    }
                }

                /*
                 * Fallback because the confirmed Gemini 1095 snackbar
                 * is also visible through document text.
                 */
                return pattern.test(
                    String(
                        document.body?.innerText ||
                        document.body?.textContent ||
                        ''
                    )
                );
            });

        if (error1095Visible) {
            const error =
                new Error(
                    'Gemini Web modal error 1095 detected: Something went wrong (1095)'
                );

            error.code =
                'GEMINI_WEB_1095';

            error.status =
                1095;

            throw error;
        }


        if (
            state.text &&
            state.text !== baseline
        ) {
            started = true;

            if (state.text === lastText) {
                stableCount++;
            } else {
                stableCount = 0;
                lastText = state.text;

                /*
                 * New response text arrived. Restart any
                 * incomplete-JSON settling window.
                 */
                incompleteSince = 0;
                incompleteLogged = false;
            }

            if (
                !state.generating &&
                stableCount >= 3
            ) {
                if (!expectJson) {
                    return state.text;
                }

                const completion =
                    geminiWebJsonCompletionState(
                        state.text
                    );

                /*
                 * Valid JSON, or complete JSON requiring only
                 * the existing narrow quote repair.
                 */
                if (completion.accepted) {
                    return state.text;
                }

                /*
                 * Complete-looking but malformed JSON belongs to
                 * the existing parser/repair path.
                 */
                if (!completion.incomplete) {
                    return state.text;
                }

                if (!incompleteSince) {
                    incompleteSince =
                        Date.now();
                }

                if (!incompleteLogged) {
                    incompleteLogged =
                        true;

                    console.warn(
                        '[GEMINI WEB] JSON response appears incomplete; waiting up to 12s for additional text'
                    );
                }

                if (
                    Date.now() -
                        incompleteSince >=
                    JSON_COMPLETION_GRACE_MS
                ) {
                    const rawResponse =
                        cleanResponse(
                            state.text
                        );

                    const error =
                        new Error(
                            'Gemini Web JSON response remained incomplete after settling'
                        );

                    error.code =
                        'GEMINI_WEB_INCOMPLETE_JSON';

                    error.rawResponse =
                        rawResponse;

                    error.originalRawResponse =
                        rawResponse;

                    error.rawResponseLength =
                        rawResponse.length;

                    error.rawResponseShownLength =
                        Math.min(
                            rawResponse.length,
                            100000
                        );

                    error.rawResponseTruncated =
                        rawResponse.length >
                        100000;

                    error.parserReason =
                        'Response stopped before the JSON document was structurally complete';

                    throw error;
                }
            }
        }

        if (
            !started &&
            /reached your limit|too many requests|try again later|couldn.t generate|something went wrong/i
                .test(state.alerts)
        ) {
            const error =
                new Error(
                    'Gemini Web reported a generation/rate-limit error'
                );

            error.code =
                'GEMINI_WEB_GENERATION_ERROR';

            throw error;
        }

        await sleep(500);
    }

    const error =
        new Error(
            'Gemini Web response timed out'
        );

    error.code =
        'GEMINI_WEB_TIMEOUT';

    throw error;
}

function cleanResponse(text) {
    return String(text || '')
        .trim()
        .replace(
            /^Gemini said\s*/i,
            ''
        )
        .trim()
        .replace(
            /^```(?:json)?\s*/i,
            ''
        )
        .replace(
            /\s*```$/,
            ''
        )
        .trim();
}


/*
 * Repair one common model-JSON failure:
 *
 *   {"text":"... "quoted words" ..."}
 *
 * Only quotes that cannot plausibly terminate the current JSON
 * string are escaped. If the repaired text still does not parse,
 * the original provider failure path is used unchanged.
 */
export function repairGeminiWebJsonQuotes(value) {
    const input =
        String(value ?? '');

    let output = '';
    let inString = false;
    let escaped = false;
    let changed = false;

    const skipWhitespace = index => {
        let next = index;

        while (
            next < input.length &&
            /\s/.test(input[next])
        ) {
            next++;
        }

        return next;
    };

    for (
        let index = 0;
        index < input.length;
        index++
    ) {
        const character =
            input[index];

        if (!inString) {
            output += character;

            if (character === '"') {
                inString = true;
                escaped = false;
            }

            continue;
        }

        if (escaped) {
            output += character;
            escaped = false;
            continue;
        }

        if (character === '\\') {
            output += character;
            escaped = true;
            continue;
        }

        if (character !== '"') {
            output += character;
            continue;
        }

        const nextIndex =
            skipWhitespace(
                index + 1
            );

        const nextCharacter =
            input[nextIndex];

        let structuralClose =
            nextIndex >=
                input.length ||
            nextCharacter === ':' ||
            nextCharacter === '}' ||
            nextCharacter === ']';

        /*
         * A comma is structural only when the following token can
         * actually begin another JSON key/value. This avoids treating
         * prose such as:
         *
         *   "word", then ...
         *
         * as a legitimate string terminator.
         */
        if (
            !structuralClose &&
            nextCharacter === ','
        ) {
            const afterCommaIndex =
                skipWhitespace(
                    nextIndex + 1
                );

            const afterComma =
                input[
                    afterCommaIndex
                ];

            structuralClose =
                afterCommaIndex >=
                    input.length ||
                afterComma === '"' ||
                afterComma === '}' ||
                afterComma === ']' ||
                afterComma === '{' ||
                afterComma === '[' ||
                afterComma === '-' ||
                /[0-9tfn]/.test(
                    afterComma || ''
                );
        }

        if (structuralClose) {
            output += '"';
            inString = false;
            continue;
        }

        output += '\\"';
        changed = true;
    }

    return {
        text:
            output,
        changed
    };
}

function buildInput(prompt, options) {
    let input =
        'Use only the information supplied in this prompt. ' +
        'Do not browse the web or use external tools.\n\n' +
        String(prompt || '');

    if (options?.schema) {
        input +=
            '\n\nReturn output that conforms exactly to this JSON Schema:\n' +
            JSON.stringify(options.schema);
    }

    if (options?.json) {
        input +=
            '\n\nReturn valid JSON only. Do not wrap it in Markdown fences.';
    }

    return input;
}

async function resetGeminiJobPage(page) {
    /*
     * Reuse this slot's browser tab and Google login.
     *
     * If the tab is not on Gemini, navigate there first.
     * Navigation itself is NOT considered a new conversation.
     */
    const current =
        await page.evaluate(
            () => ({
                url:
                    location.href
            })
        ).catch(
            () => ({
                url: ''
            })
        );

    if (
        !/^https:\/\/gemini\.google\.com\//i.test(
            current.url ||
            ''
        )
    ) {
        console.log(
            '[GEMINI WEB] Opening Gemini app in existing slot'
        );

        await page.goto(
            GEMINI_WEB_URL
        );

        await waitForGeminiPage(
            page,
            20000
        );
    }

    /*
     * Every AI job must receive a genuinely new conversation.
     */
    await returnToGeminiChatHome(
        page
    );

    /*
     * Then turn Temporary Chat ON for that new conversation.
     */
    await resetFreshTemporaryChat(
        page
    );

    await sleep(500);
}


async function runOnSlot(
    slot,
    prompt,
    options
) {
    const page =
        await getPage(slot);

    try {
        /*
         * Reuse this slot's existing browser tab, but start
         * every job from a completely fresh Gemini page.
         */
        await resetGeminiJobPage(page);

        /*
         * Strict requirements:
         * 1. Temporary Chat must be ON.
         * 2. Model must be 3.8 Flash.
         * 3. Extended thinking must NOT be selected.
         *
         * Gemini occasionally renders the prompt box before
         * the mode picker. If that happens once, hard-reset
         * this SAME tab and retry.
         */
        try {
            await ensureModel(
                page,
                options?.geminiWebMode ||
                    '3.8'
            );
        } catch (error) {
            if (
                error?.code !==
                'GEMINI_WEB_MODE_PICKER_NOT_FOUND'
            ) {
                throw error;
            }

            console.warn(
                `[GEMINI WEB] Slot ${slot.id}: mode picker missing; reloading same tab once`
            );

            await resetGeminiJobPage(page);
            await ensureModel(
                page,
                options?.geminiWebMode ||
                    '3.8'
            );
        }

        const before =
            await responseState(page);

        const input =
            buildInput(
                prompt,
                options
            );

        await setPrompt(
            page,
            input
        );

        options.onRequest?.();

        await submitPrompt(page);

        return await waitForResponse(
            page,
            before.text || '',
            Math.max(
                5000,
                Math.min(
                    180000,
                    Number(options.timeoutMs) ||
                    120000
                )
            ),
            Boolean(options?.json)
        );
    } catch (error) {
        // Discard a bad tab/session. The slot itself remains reusable.
        try {
            await slot.page
                ?.closeWindow?.();
        } catch {
            // Ignore cleanup errors.
        }

        slot.page = null;

        throw error;
    }
}

export async function closeGeminiWebSlots() {
    await Promise.all(
        slots.map(
            slot =>
                closeSlotPage(
                    slot,
                    'manual cleanup'
                )
        )
    );
}


export async function generateWithGeminiWeb(
    prompt,
    options = {}
) {
    if (
        process.env.GEMINI_WEB_ENABLED === 'false'
    ) {
        throw new Error(
            'Gemini Web provider is disabled'
        );
    }

    if (Date.now() < retryAt) {
    const error =
        new Error(
            `Gemini Web is cooling down until ${
                new Date(retryAt).toISOString()
            }; use the next provider`
        );

    error.code =
        'GEMINI_WEB_COOLDOWN';

    error.retryAt =
        retryAt;

    error.cooldownUntil =
        retryAt;

    error.skipProvider =
        true;

    error.nonProviderFault =
        true;

    throw error;
}

const inputBytes =
        Buffer.byteLength(
            String(prompt || ''),
            'utf8'
        );

    if (inputBytes > 180000) {
        throw new Error(
            'Gemini Web prompt is too large'
        );
    }

    const slot =
        acquireSlot();

    const startedAt =
        Date.now();

    try {
    let rawText;

    let firstIncompleteRawResponse =
        null;

    try {
        rawText =
            await runOnSlot(
                slot,
                prompt,
                options
            );
    }
    catch (error) {
        if (
            !options?.json ||
            error?.code !==
                'GEMINI_WEB_INCOMPLETE_JSON'
        ) {
            throw error;
        }

        firstIncompleteRawResponse =
            error?.rawResponse ||
            '';

        console.warn(
            '[GEMINI WEB] Incomplete JSON remained stable; regenerating once'
        );

        rawText =
            await runOnSlot(
                slot,
                prompt,
                options
            );
    }

        let text =
              cleanResponse(rawText);
          const originalText = text;

        if (!text) {
            const error =
                new Error(
                    'Gemini Web returned an empty response'
                );

            error.code =
                'GEMINI_WEB_EMPTY';

            throw error;
        }

        if (options.json) {
            try {
                JSON.parse(text);
            }
            catch (parseError) {
                const repair =
                    repairGeminiWebJsonQuotes(
                        text
                    );

                let repaired =
                    false;

                let repairedParseError =
                    null;

                if (repair.changed) {
                    try {
                        JSON.parse(
                            repair.text
                        );

                        text =
                            repair.text;

                        repaired =
                            true;

                        console.warn(
                            '[GEMINI WEB] Repaired unescaped quote(s) inside model JSON'
                        );
                    }
                    catch (error) {
                        repairedParseError =
                            error;
                    }
                }

                if (!repaired) {
                    const error =
                        new Error(
                            'Gemini Web returned invalid JSON'
                        );

                    error.code =
                        'GEMINI_WEB_INVALID_JSON';

                    error.rawResponse =
                        originalText;

                    error.originalRawResponse =
                        originalText;

                    if (
                        firstIncompleteRawResponse
                    ) {
                        error.firstRawResponse =
                            firstIncompleteRawResponse;
                    }

                    error.rawResponseLength =
                        originalText.length;

                    error.rawResponseShownLength =
                        Math.min(
                            originalText.length,
                            100000
                        );

                    error.rawResponseTruncated =
                        originalText.length >
                        100000;

                    error.repairAttempted =
                        repair.changed;

                    error.parserReason =
                        String(
                            parseError?.message ||
                            'JSON.parse failed'
                        ).slice(
                            0,
                            500
                        );

                    if (repairedParseError) {
                        error.repairedParserReason =
                            String(
                                repairedParseError?.message ||
                                'Repaired JSON.parse failed'
                            ).slice(
                                0,
                                500
                            );
                    }

                    error.reason =
                        error.parserReason;

                    error.originalReason =
                        error.parserReason;

                    throw error;
                }
            }
        }

        retryAt = 0;

        const usage = {
            promptTokens: 0,
            outputTokens: 0,
            totalTokens: 0
        };

        console.log(
            '[ONLINE AI]',
            JSON.stringify({
                at:
                    new Date()
                        .toISOString(),
                provider:
                    'gemini-web',
                operation:
                    options.operation ||
                    'summary',
                model:
                    GEMINI_WEB_MODEL,
                slot:
                    slot.id,
                status:
                    'success',
                durationMs:
                    Date.now() -
                    startedAt,
                ...usage
            })
        );

        return {
            text,
            provider:
                'gemini-web',
            modelUsed:
                GEMINI_WEB_MODEL,
            totalDuration:
                (
                    Date.now() -
                    startedAt
                ) * 1e6,
            usage,
            onlineAiUsage:
                usage,
            slot:
                slot.id
        };
    } catch (error) {
        const is1095 =
            isGeminiWeb1095Error(error);

        const appliedCooldownMs =
            is1095
                ? GEMINI_WEB_1095_COOLDOWN_MS
                : GEMINI_WEB_COOLDOWN_MS;

        retryAt =
            Date.now() +
            appliedCooldownMs;

        if (is1095) {
            error.code =
                'GEMINI_WEB_1095';

            error.cooldownMs =
                appliedCooldownMs;

            error.cooldownUntil =
                retryAt;

            console.warn(
                '[GEMINI WEB] Error 1095; cooling down globally for 60 seconds',
                JSON.stringify({
                    cooldownMs:
                        appliedCooldownMs,

                    cooldownUntil:
                        new Date(
                            retryAt
                        ).toISOString()
                })
            );
        }

        console.log(
            '[ONLINE AI]',
            JSON.stringify({
                at:
                    new Date()
                        .toISOString(),
                provider:
                    'gemini-web',
                operation:
                    options.operation ||
                    'summary',
                model:
                    GEMINI_WEB_MODEL,
                slot:
                    slot.id,
                status:
                    'failed',
                durationMs:
                    Date.now() -
                    startedAt,
                errorCode:
                    String(
                        error.code ||
                        error.name ||
                        'GEMINI_WEB_FAILED'
                    ).slice(0, 80),
                error:
                    String(
                        error.message ||
                        error
                    )
                        .replace(
                            /\s+/g,
                            ' '
                        )
                        .slice(
                            0,
                            500
                        ),
                parserReason:
                    error.parserReason ||
                    error.originalReason ||
                    error.reason ||
                    undefined,
                rawResponse:
                    error.rawResponse
                        ? String(error.rawResponse).slice(0, 100000)
                        : undefined,
                rawResponseLength:
                    error.rawResponse
                        ? String(error.rawResponse).length
                        : undefined,
                rawResponseShownLength:
                    error.rawResponse
                        ? Math.min(
                            String(error.rawResponse).length,
                            100000
                        )
                        : undefined,
                rawResponseTruncated:
                    error.rawResponse
                        ? String(error.rawResponse).length > 100000
                        : false,
                ui:
                    error.ui ||
                    undefined
            })
        );

        throw error;
    } finally {
        releaseSlot(slot);
    }
}
